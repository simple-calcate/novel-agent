{
  "id": "continuation-writer",
  "name": "智能续写",
  "version": "0.1.0",
  "apiVersion": 1,
  "platforms": ["linux", "windows", "android"],
  "operations": [
    {
      "name": "continue-scene",
      "description": "基于当前场景上下文生成续写候选",
      "inputSchema": {
        "type": "object",
        "required": ["chapterId", "revision"],
        "properties": {
          "chapterId": { "type": "string" },
          "revision": { "type": "integer" },
          "maxTokens": { "type": "integer", "default": 2048 },
          "style": { "type": "string" }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["patch"],
        "properties": {
          "patch": { "type": "object" },
          "rationale": { "type": "string" }
        }
      },
      "triggers": ["editor.idle"]
    }
  ],
  "requestedCapabilities": [
    { "kind": "readChapter", "scope": "current" },
    { "kind": "readStoryModel" },
    { "kind": "proposePatch" },
    { "kind": "model", "provider": "any", "maxCostMicros": 500000 }
  ],
  "settingsSchema": {
    "type": "object",
    "properties": {
      "defaultMaxTokens": { "type": "integer", "default": 2048 },
      "temperature": { "type": "number", "default": 0.8 }
    }
  }
}
