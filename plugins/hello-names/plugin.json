{
  "id": "hello-names",
  "name": "人名点名",
  "version": "0.1.0",
  "apiVersion": 1,
  "platforms": [
    "linux",
    "windows"
  ],
  "operations": [
    {
      "name": "count-names",
      "description": "统计选区里出现了多少次给定人名",
      "inputSchema": {
        "type": "object",
        "required": [
          "names"
        ],
        "properties": {
          "names": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "selection": {
            "type": "string"
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "counts"
        ],
        "properties": {
          "counts": {
            "type": "object"
          }
        }
      },
      "triggers": [
        "editor.idle"
      ]
    }
  ],
  "requestedCapabilities": [
    {
      "kind": "readSelection"
    },
    {
      "kind": "log"
    }
  ],
  "wasmBase64": ""
}
