{
  "id": "summary-extractor",
  "name": "章节摘要与实体抽取",
  "version": "0.1.0",
  "apiVersion": 1,
  "platforms": ["linux", "windows", "android"],
  "operations": [
    {
      "name": "extract-story-delta",
      "description": "从章节正文中抽取新增事实、状态变化和伏笔",
      "inputSchema": {
        "type": "object",
        "required": ["chapterId", "revision"],
        "properties": {
          "chapterId": { "type": "string" },
          "revision": { "type": "integer" }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["delta"],
        "properties": {
          "delta": {
            "type": "object",
            "properties": {
              "newFacts": { "type": "array" },
              "stateChanges": { "type": "array" },
              "relationships": { "type": "array" },
              "events": { "type": "array" },
              "knowledgeUpdates": { "type": "array" },
              "foreshadowing": { "type": "array" }
            }
          }
        }
      },
      "triggers": ["document.saved", "chapter.completed"]
    }
  ],
  "requestedCapabilities": [
    { "kind": "readChapter", "scope": "current" },
    { "kind": "log" }
  ],
  "settingsSchema": {
    "type": "object",
    "properties": {
      "autoAcceptHighConfidence": { "type": "boolean", "default": false }
    }
  }
}
