{
  "id": "continuity-checker",
  "name": "连续性检查",
  "version": "0.1.0",
  "apiVersion": 1,
  "platforms": ["linux", "windows"],
  "operations": [
    {
      "name": "check-chapter",
      "description": "检查章节内的人物状态、时间线和设定冲突",
      "inputSchema": {
        "type": "object",
        "required": ["chapterId"],
        "properties": {
          "chapterId": { "type": "string" },
          "scope": { "enum": ["chapter", "book"] }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["issues"],
        "properties": {
          "issues": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["severity", "code", "message"],
              "properties": {
                "severity": { "enum": ["info", "warning", "error"] },
                "code": { "type": "string" },
                "message": { "type": "string" },
                "evidence": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      },
      "triggers": ["chapter.completed", "document.saved"]
    }
  ],
  "requestedCapabilities": [
    { "kind": "readChapter", "scope": "current" },
    { "kind": "readStoryModel" },
    { "kind": "log" }
  ],
  "settingsSchema": {
    "type": "object",
    "properties": {
      "strictMode": { "type": "boolean", "default": false },
      "ignoredRules": { "type": "array", "items": { "type": "string" } }
    }
  }
}
