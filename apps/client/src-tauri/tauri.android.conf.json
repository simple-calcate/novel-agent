{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "墨枢 Novel Agent",
  "version": "0.1.0",
  "identifier": "com.novelagent.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "墨枢 Novel Agent",
        "fullscreen": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "android": {
      "minSdkVersion": 26
    }
  }
}
